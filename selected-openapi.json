{
  "openapi": "3.1.0",
  "info": {
    "title": "Zendesk selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://{ZENDESK_SUBDOMAIN}.zendesk.com/api/v2",
      "variables": {
        "ZENDESK_SUBDOMAIN": {
          "default": "your-account",
          "description": "Replace with your own authorized provider account value."
        }
      }
    }
  ],
  "paths": {
    "/tickets.json": {
      "get": {
        "operationId": "zendesk_list_tickets",
        "summary": "zendesk list tickets",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "zendesk_create_ticket",
        "summary": "zendesk create ticket",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "comment": {
                        "type": "object",
                        "properties": {
                          "body": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "body"
                        ]
                      }
                    },
                    "required": [
                      "subject"
                    ]
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    },
    "/tickets/{id}.json": {
      "get": {
        "operationId": "zendesk_get_ticket",
        "summary": "zendesk get ticket",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
